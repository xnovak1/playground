echo "Linting and formatting staged files in todo-list..."
#!/bin/sh
# Pre-commit hook (Husky v10+ friendly)

# Get staged JS/TS files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|ts)$')

# Exit if none
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Formatting and linting staged files..."

# Use npm's exec to run local binaries
npm exec -- prettier --write $STAGED_FILES || true
npm exec -- eslint --fix $STAGED_FILES || true

# Re-stage changes
git add $STAGED_FILES